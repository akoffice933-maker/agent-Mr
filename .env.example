# ── Обязательное ────────────────────────────────────────────────────────────
# PostgreSQL. Приложение — под ролью, подчинённой RLS (appuser).
# Миграции (drizzle-kit) и сид выполняйте привилегированной ролью (BYPASSRLS):
#   DATABASE_URL=postgresql://dbowner:...@.../app_db npx drizzle-kit migrate
#   DATABASE_URL=postgresql://dbowner:...@.../app_db npm run seed
DATABASE_URL=postgresql://appuser:apppass@127.0.0.1:5432/app_db

# Ключ шифрования OAuth-токенов в БД (произвольная строка, не публикуйте)
ENCRYPTION_KEY=change-me-32-chars-min-0123456789

# ── LLM-ядро (этап 1) — без ключа агент работает на rule-based парсере ─────
OPENROUTER_API_KEY=
# Любая модель OpenRouter с поддержкой tool calling
OPENROUTER_MODEL=openai/gpt-4o-mini

# ── Аутентификация REST API ─────────────────────────────────────────────────
# AGENT_API_KEY — ключ клиентов (MCP/Telegram/внешние) в заголовке x-api-key.
# AGENT_MODE=production включает fail-closed: без AGENT_API_KEY REST API
# полностью недоступен (503). Локальная разработка работает без ключа.
AGENT_API_KEY=
# AGENT_MODE=production

# ── Доверенный прокси (rate-limit / brute-force по IP) ──────────────────────
# Если приложение за reverse-proxy, укажите IP/CIDR этого прокси, чтобы
# доверять X-Forwarded-For (иначе клиент может подменить заголовок и обойти
# лимиты).
#
# ВАЖНО: код проверяет ПОСЛЕДНИЙ хоп X-Forwarded-For — он должен быть
# собственным адресом прокси (а не IP клиента и не то, что клиент прислал
# сам). Просто "перезаписать" заголовок ($remote_addr) даёт ОДИН хоп, а
# код требует минимум два — с одним хопом доверие НИКОГДА не сработает, и
# все клиенты схлопнутся в общий бакет "untrusted" (один клиент сможет
# исчерпать лимит/локаут для всех остальных).
#
# Рабочая nginx-директива (полностью игнорирует то, что прислал клиент —
# не append к $http_x_forwarded_for, иначе клиент может подставить хопы
# перед настоящим и обмануть подсчёт hops[0]):
#   proxy_set_header X-Forwarded-For "$remote_addr, $server_addr";
# Тогда TRUSTED_PROXY = CIDR/адрес самого nginx (см. $server_addr выше).
# TRUSTED_PROXY=10.0.0.1,10.0.0.0/8
#
# ── Публичный URL (для OAuth redirect-uri; в dev можно оставить пустым) ─────
PUBLIC_URL=http://localhost:3000

# ── Google Ads (этап 3): OAuth + developer token ───────────────────────────
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CUSTOMER_ID=

# ── Яндекс.Директ (этап 4): OAuth-приложение Яндекса ────────────────────────
YANDEX_OAUTH_CLIENT_ID=
YANDEX_OAUTH_CLIENT_SECRET=

# ── Авито Business API (этап 5): ключи из ЛК Авито → Настройки → API ────────
AVITO_CLIENT_ID=
AVITO_CLIENT_SECRET=
AVITO_USER_ID=  # опционально: без него берётся из /core/v1/accounts/self
# AVITO_API_VERSION=v1

# ── Telegram-бот (этап 8; только для telegram-bot/) ─────────────────────────
TELEGRAM_BOT_TOKEN=
# ОБЯЗАТЕЛЬНО: список chat id через запятую, которым разрешено управлять агентом.
# Бот держит AGENT_API_KEY и проксирует команды агенту, а его @username может
# найти кто угодно — без этого списка любой человек управлял бы вашими кабинетами.
# Пусто = бот отвечает «нет доступа» ВСЕМ (fail-closed). Чтобы узнать свой id,
# напишите боту — он вернёт его в ответе. Группа — отрицательный id.
TELEGRAM_ALLOWED_CHATS=   # напр. 123456789,-1001234567890

# ── Пул подключений к БД (необязательно; значения по умолчанию в скобках) ────
# withTenant() закрепляет одно соединение на весь запрос, а запрос к агенту
# может ждать ответа LLM десятки секунд — поэтому размер пула имеет значение.
# Следите, чтобы (реплики × DB_POOL_MAX) не превышало max_connections сервера.
# DB_POOL_MAX=10
# DB_CONNECT_TIMEOUT_MS=5000
# DB_IDLE_TIMEOUT_MS=30000
# DB_STATEMENT_TIMEOUT_MS=30000

# ── Self-serve signup ──────────────────────────────────────────────────────
# open (default) — anyone may register and gets their own organization
# code           — registration requires SIGNUP_INVITE_CODE (controlled beta)
# off            — registration disabled; accounts via CLI/invites only
SIGNUP_MODE=open
# SIGNUP_INVITE_CODE=some-long-random-string
# Hard-gate login until the address is confirmed. Turn on only once SMTP is
# known to work — otherwise nobody can log in.
# SIGNUP_REQUIRE_VERIFIED_EMAIL=on

# Public base URL used to build links inside emails. NEVER derived from the
# Host header: a poisoned header would send verification links to another
# domain (account-takeover primitive).
APP_BASE_URL=http://localhost:3000

# ── Email (SMTP) ───────────────────────────────────────────────────────────
# Without SMTP_HOST the app still works: verification links are written to the
# logs and returned by the signup API instead of being emailed.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false          # true for implicit TLS on port 465
# SMTP_USER=
# SMTP_PASSWORD=
# MAIL_FROM="Agent Mr <no-reply@example.com>"

# ── Billing ────────────────────────────────────────────────────────────────
# Both providers are optional; configure either, both, or neither.
# ЮKassa (Russian market)
# YOOKASSA_SHOP_ID=
# YOOKASSA_SECRET_KEY=
# ЮKassa does not sign webhooks. Set a random value here and append it to the
# webhook URL as ?s=<value> for a cheap extra filter; the handler additionally
# re-reads every payment from the ЮKassa API before granting a plan.
# YOOKASSA_WEBHOOK_SECRET=
# Stripe (cards, international)
# STRIPE_SECRET_KEY=
# STRIPE_PRICE_PRO=price_...
# Required for the Stripe webhook to accept anything at all (fail-closed).
# STRIPE_WEBHOOK_SECRET=whsec_...
